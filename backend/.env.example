ENVIRONMENT=development

# auto = OpenRouter if its key is set, else OpenAI, else offline mode (canned answers).
# fake = always offline. Values: auto | openrouter | openai | fake
LLM_PROVIDER=auto

# Voice (GPT-Live-1, OpenAI only). Without OpenRouter, also used for extraction and chat.
OPENAI_API_KEY=
# VOICE_NAME=marin
# VOICE_BACKEND_MODEL=gpt-5.6-terra

# Extraction + chat via OpenRouter (Claude, GPT, Gemini with one key)
OPENROUTER_API_KEY=
